<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Proposta de Análise Estratégica Inicial | Análise Legal</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#082c27" />

  <link rel="icon" type="image/svg+xml" href="/assets/img/Simbolo.svg" />
  <link rel="preload" as="image" href="/assets/img/Marca.svg" />
  <link rel="preload" as="image" href="/assets/img/Marca-PB.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --verde: #082c27;
      --verde2: #0d3b34;
      --dourado: #c8a44b;
      --dourado2: #d8b45f;
      --dourado3: #b78d2f;
      --bege: #f4f0e8;
      --texto: #1f2933;
      --cinza: #5b6470;
      --borda: #e3dac6;
      --box: #fbf8ef;
      --alerta: #fff7d6;
      --alerta-borda: #e3c768;
      --ok: #e8f5ee;
      --erro: #fdecea;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: "Crimson Text", Georgia, serif;
      background: var(--bege);
      color: var(--texto);
      font-size: 19px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: auto;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    .skip-link:focus {
      left: 1rem;
      top: 1rem;
      width: auto;
      height: auto;
      z-index: 9999;
      background: #fff;
      color: var(--verde);
      padding: 0.6rem 0.9rem;
      border-radius: 8px;
      text-decoration: none;
    }

    header {
      background: linear-gradient(135deg, var(--verde), var(--verde2));
      color: #fff;
      padding: 24px 18px;
      border-bottom-left-radius: 18px;
      border-bottom-right-radius: 18px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.18);
    }

    .header-inner {
      width: min(100%, 980px);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand-web {
      width: 190px;
      max-width: 62vw;
      height: auto;
      display: block;
    }

    .tag {
      color: #eadfbf;
      font-size: 0.95rem;
      text-align: right;
    }

    .print-brand {
      display: none;
    }

    main {
      width: min(100%, 980px);
      margin: 0 auto;
      padding: 28px 16px 46px;
    }

    .card {
      background: #fff;
      border: 1px solid var(--borda);
      border-radius: 20px;
      box-shadow: 0 16px 42px rgba(8, 44, 39, 0.11);
      padding: 28px;
      margin: 18px 0;
    }

    h1 {
      color: var(--verde);
      font-size: clamp(2rem, 5vw, 2.9rem);
      line-height: 1.05;
      margin: 0 0 10px;
      letter-spacing: -0.02em;
    }

    h2 {
      color: var(--verde);
      font-size: 1.55rem;
      margin: 26px 0 10px;
      line-height: 1.12;
    }

    h3 {
      color: var(--verde);
      font-size: 1.28rem;
      margin: 20px 0 8px;
      line-height: 1.12;
    }

    p {
      margin: 7px 0 12px;
      text-align: justify;
    }

    ul {
      margin: 8px 0 14px;
      padding-left: 1.25rem;
    }

    li {
      margin: 6px 0;
      text-align: justify;
    }

    li::marker {
      color: var(--dourado);
    }

    .intro {
      color: #475569;
      margin-bottom: 14px;
    }

    .protocol-box {
      background: var(--box);
      border: 1px solid var(--borda);
      border-radius: 16px;
      padding: 13px 15px;
      margin: 14px 0 18px;
      line-height: 1.35;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 16px;
      margin: 8px 0 4px;
    }

    .meta-item {
      border-bottom: 1px solid #efe7d7;
      padding: 4px 0 6px;
      min-height: 38px;
    }

    .label {
      display: block;
      font-size: 0.98rem;
      color: var(--cinza);
      font-weight: 700;
      line-height: 1.08;
    }

    .value {
      display: block;
      font-size: 1.12rem;
      color: var(--texto);
      line-height: 1.18;
      word-break: break-word;
    }

    .proposal-section {
      border-top: 1px solid #efe7d7;
      padding-top: 8px;
    }

    .value-box {
      background: #f3eee2;
      border: 1px solid var(--borda);
      border-radius: 14px;
      padding: 14px 16px;
      margin: 14px 0;
    }

    .price {
      font-size: 1.8rem;
      color: var(--verde);
      font-weight: 700;
      margin: 4px 0;
    }

    .schedule-box {
      background: #fbf8ef;
      border: 1px solid var(--borda);
      border-radius: 18px;
      padding: 18px;
      margin-top: 24px;
    }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 14px 0 18px;
    }

    .choice-card {
      border: 1px solid var(--borda);
      border-radius: 16px;
      padding: 14px;
      background: #fff;
      cursor: pointer;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .choice-card:hover {
      transform: translateY(-1px);
      border-color: var(--dourado);
      box-shadow: 0 8px 20px rgba(8, 44, 39, 0.08);
    }

    .choice-card input {
      margin-right: 8px;
    }

    .choice-card strong {
      color: var(--verde);
      font-size: 1.1rem;
    }

    .choice-card small {
      display: block;
      color: var(--cinza);
      margin-top: 4px;
      line-height: 1.3;
    }

    .time-options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 14px 0 18px;
    }

    .time-card {
      border: 1px solid var(--borda);
      border-radius: 16px;
      background: #fff;
      padding: 14px;
      cursor: pointer;
    }

    .time-card input {
      margin-right: 8px;
    }

    .time-card strong {
      color: var(--verde);
      font-size: 1.16rem;
    }

    .time-card span {
      display: block;
      color: var(--cinza);
      margin-top: 4px;
      font-size: 0.98rem;
    }

    .notice {
      background: var(--alerta);
      border: 1px solid var(--alerta-borda);
      border-radius: 14px;
      padding: 13px 15px;
      margin: 16px 0;
      color: #4f3d00;
      line-height: 1.38;
    }

    .checks {
      margin-top: 18px;
    }

    .check-line {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      margin: 12px 0;
      background: #fff;
      border: 1px solid var(--borda);
      border-radius: 14px;
      padding: 12px 14px;
    }

    .check-line input {
      margin-top: 5px;
      flex: 0 0 auto;
    }

    .check-line label {
      cursor: pointer;
      line-height: 1.35;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 22px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      padding: 0 24px;
      border-radius: 14px;
      border: 0;
      font-family: inherit;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-decoration: none;
      cursor: pointer;
      text-transform: uppercase;
      font-size: 0.96rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--dourado), var(--dourado2), var(--dourado3));
      color: #17231f;
      box-shadow: 0 10px 26px rgba(8, 44, 39, 0.16);
    }

    .btn-secondary {
      background: #e7dfd0;
      color: #18352f;
    }

    .btn:disabled {
      opacity: 0.48;
      cursor: not-allowed;
      box-shadow: none;
    }

    .payment-box {
      display: none;
      margin-top: 22px;
      background: #f3eee2;
      border: 1px solid var(--borda);
      border-radius: 18px;
      padding: 18px;
    }

    .payment-box.visible {
      display: block;
    }

    .pix-key {
      background: #fff;
      border: 1px dashed var(--dourado);
      border-radius: 12px;
      padding: 12px;
      word-break: break-word;
      font-weight: 700;
      color: var(--verde);
      margin: 10px 0;
    }

    .status {
      display: none;
      margin-top: 14px;
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 0.98rem;
    }

    .status.visible {
      display: block;
    }

    .status.ok {
      background: var(--ok);
      border: 1px solid #b6d8c2;
      color: #1b5e3a;
    }

    .status.erro {
      background: var(--erro);
      border: 1px solid #f5b8b0;
      color: #8b1f15;
    }

    footer {
      background: linear-gradient(135deg, var(--verde), var(--verde2));
      color: #f8f2df;
      padding: 24px 16px;
      text-align: center;
      font-size: 0.95rem;
      margin-top: 36px;
    }

    footer a {
      color: #f3d98a;
      text-decoration: none;
    }

    .trademark {
      font-size: 0.58em;
      vertical-align: super;
      line-height: 0;
    }

    @media (max-width: 720px) {
      .header-inner {
        display: block;
      }

      .tag {
        text-align: left;
        margin-top: 10px;
      }

      main {
        padding: 22px 14px 40px;
      }

      .card {
        padding: 22px 18px;
        border-radius: 18px;
      }

      .meta-grid,
      .choice-grid,
      .time-options {
        grid-template-columns: 1fr;
      }

      .actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }

    @media print {
      @page {
        size: A4;
        margin: 10mm 10mm;
      }

      * {
        animation: none !important;
        transition: none !important;
        box-shadow: none !important;
        text-shadow: none !important;
        background-image: none !important;
      }

      html,
      body {
        background: #fff !important;
        color: #000 !important;
        font-size: 10.6pt !important;
        line-height: 1.18 !important;
        overflow: visible !important;
      }

      header,
      footer,
      .actions,
      .payment-box,
      .status,
      .skip-link,
      .no-print {
        display: none !important;
      }

      .print-brand {
        display: block !important;
        margin: 0 0 3mm 0;
        padding-bottom: 2mm;
        border-bottom: 1px solid #d7d0c2;
      }

      .print-brand img {
        display: block !important;
        width: 42mm;
        height: auto;
      }

      main {
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .card {
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      h1 {
        font-size: 17pt !important;
        line-height: 1.05 !important;
        margin: 0 0 2mm !important;
        color: #000 !important;
      }

      h2 {
        font-size: 12.4pt !important;
        line-height: 1.08 !important;
        margin: 4mm 0 1.3mm !important;
        color: #000 !important;
        break-after: avoid;
        page-break-after: avoid;
      }

      h3 {
        font-size: 11.2pt !important;
        margin: 3mm 0 1mm !important;
        color: #000 !important;
      }

      p,
      li {
        font-size: 10.2pt !important;
        line-height: 1.22 !important;
        color: #000 !important;
        text-align: justify !important;
        margin: 0.8mm 0 !important;
      }

      ul {
        margin: 1mm 0 2mm !important;
        padding-left: 5mm !important;
      }

      li {
        margin-bottom: 0.8mm !important;
      }

      .protocol-box,
      .value-box,
      .schedule-box,
      .notice,
      .check-line,
      .choice-card,
      .time-card {
        background: #fff !important;
        border: 1px solid #d7d0c2 !important;
        border-radius: 0 !important;
        padding: 1.4mm !important;
        margin: 1.3mm 0 !important;
      }

      .meta-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 0.8mm 4mm !important;
      }

      .meta-item {
        min-height: auto !important;
        padding: 0.4mm 0 !important;
      }

      .label {
        font-size: 9pt !important;
        color: #000 !important;
      }

      .value {
        font-size: 10pt !important;
        color: #000 !important;
      }

      .price {
        font-size: 14pt !important;
        color: #000 !important;
      }

      .choice-grid,
      .time-options {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 2mm !important;
      }

      input {
        accent-color: #000;
      }
    }
  </style>
</head>

<body>
  <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

  <header>
    <div class="header-inner">
      <a href="/" aria-label="Análise Legal">
        <img src="../../../assets/img/Marca.svg" alt="Análise Legal" class="brand-web">
      </a>
      <div class="tag">Precisão jurídica para decisões relevantes</div>
    </div>
  </header>

  <div class="print-brand">
    <img src="../../../assets/img/Marca-PB.svg" alt="Análise Legal">
  </div>

  <main id="conteudo">
    <section class="card">
      <h1>Proposta de Análise Estratégica Inicial</h1>

      <p class="intro">
        Esta página apresenta os termos da proposta de análise estratégica inicial, a seleção operacional de reunião
        e as condições de pré-reserva de horário.
      </p>

      <div class="protocol-box">
        <div class="meta-grid">
          <div class="meta-item">
            <span class="label">Protocolo</span>
            <span class="value" id="protocoloTopo">{{protocolo}}</span>
          </div>

          <div class="meta-item">
            <span class="label">Solicitante</span>
            <span class="value" id="nomeTopo">{{nome}}</span>
          </div>

          <div class="meta-item">
            <span class="label">Data da proposta</span>
            <span class="value" id="dataProposta">{{data_proposta}}</span>
          </div>

          <div class="meta-item">
            <span class="label">Origem</span>
            <span class="value" id="origemDemanda">{{origem_demanda}}</span>
          </div>
        </div>
      </div>

      <div class="proposal-section">
        <h2>1. Finalidade da proposta</h2>

        <p>
          Esta proposta tem por finalidade viabilizar a realização de análise estratégica inicial a partir das informações
          apresentadas pelo solicitante no formulário da plataforma ANÁLISE LEGAL<span class="trademark">™</span> e, se for o caso,
          das informações complementares encaminhadas posteriormente.
        </p>

        <p>
          A análise inicial não substitui eventual atuação jurídica, administrativa, negocial ou contenciosa futura.
          Trata-se de etapa destinada à organização técnica da demanda, identificação de riscos aparentes,
          esclarecimento de caminhos possíveis e apoio à tomada de decisão sobre os próximos passos.
        </p>

        <h2>2. Escopo do serviço</h2>

        <p>
          O serviço compreende a análise preliminar das informações fornecidas pelo solicitante, a estruturação técnica
          dos fatos, documentos e circunstâncias relacionados à demanda apresentada, a identificação dos principais
          pontos de atenção e a realização de reunião inicial para apresentação das conclusões.
        </p>

        <p>
          A análise poderá abordar, conforme o caso, aspectos documentais, prazos relevantes, riscos imediatos,
          necessidade de complementação de informações, alternativas administrativas ou extrajudiciais e eventual
          conveniência de contratação posterior de serviço técnico específico.
        </p>

        <h2>3. O que está incluído</h2>

        <ul>
          <li>leitura e organização das informações encaminhadas;</li>
          <li>identificação dos pontos centrais da demanda;</li>
          <li>análise preliminar de riscos e urgência;</li>
          <li>indicação de documentos ou informações complementares relevantes;</li>
          <li>reunião de apresentação da análise inicial;</li>
          <li>encaminhamento de síntese objetiva ao solicitante, quando necessário.</li>
        </ul>

        <h2>4. O que não está incluído</h2>

        <p>
          Não estão incluídos nesta proposta o ajuizamento de ação judicial, a apresentação de defesa, recurso,
          manifestação administrativa, parecer jurídico completo, elaboração de contrato complexo, acompanhamento
          processual, protocolo perante órgão público ou privado, negociação com terceiros ou qualquer atuação continuada.
        </p>

        <p>
          Caso alguma dessas providências seja necessária, poderá ser apresentada proposta própria, autônoma e posterior.
        </p>

        <p>
          A presente proposta refere-se exclusivamente à etapa inicial de análise e organização técnica da demanda
          apresentada, não implicando obrigação de contratação futura de serviços adicionais, nem garantia de continuidade
          de atuação profissional após a conclusão desta etapa.
        </p>

        <h2>5. Valor e pagamento</h2>

        <div class="value-box">
          <span class="label">Valor da análise estratégica inicial</span>
          <p class="price" id="valorProposta">R$ {{valor}}</p>
          <p>
            O valor indicado refere-se exclusivamente à etapa de análise estratégica inicial, não abrangendo serviços
            posteriores eventualmente necessários.
          </p>
        </div>

        <p>
          O pagamento deverá ser realizado por meio das instruções encaminhadas após o aceite desta proposta.
          A confirmação do pagamento é condição para o agendamento definitivo da reunião e para o início da análise.
        </p>

        <h2>6. Prazo estimado</h2>

        <p>
          Após a confirmação do pagamento e o recebimento das informações mínimas necessárias, a análise será preparada
          no prazo estimado de <strong id="prazoProposta">{{prazo}}</strong>, salvo necessidade de complementação documental
          ou ajuste de agenda.
        </p>

        <h2>7. Reunião inicial</h2>

        <p>
          A reunião inicial poderá ocorrer de forma virtual ou presencial, conforme a modalidade escolhida pelo solicitante
          e a disponibilidade operacional existente no momento do aceite.
        </p>

        <p>
          Os dias e horários apresentados corresponderão sempre às primeiras disponibilidades de agenda, buscando proporcionar
          atendimento em prazo razoável e adequado.
        </p>

        <p>
          A escolha da data e do horário não representa confirmação definitiva da reunião. O horário selecionado ficará
          temporariamente pré-reservado e dependerá do aceite da presente proposta e da confirmação do pagamento dentro
          do prazo atualmente fixado em 15 minutos.
        </p>

        <p>
          Pagamentos realizados após o horário comercial serão processados no próximo dia útil. Nessas hipóteses,
          o horário permanecerá pré-reservado até a validação operacional do pagamento.
        </p>

        <p>
          Por segurança operacional, a plataforma poderá limitar a quantidade de pré-reservas ativas vinculadas ao mesmo
          CPF, e-mail, telefone ou endereço de IP, bem como submeter solicitações realizadas fora do horário comercial,
          em finais de semana ou feriados à validação operacional posterior.
        </p>

        <p>
          A pré-reserva de horário não impede verificações internas de consistência, disponibilidade e regularidade do fluxo.
          Caso sejam identificadas inconsistências, duplicidades ou impossibilidade operacional, a solicitação poderá ser
          revista antes da confirmação definitiva da reunião.
        </p>

        <h2>8. Limites da análise</h2>

        <p>
          A análise será realizada com base exclusivamente nas informações e documentos disponibilizados pelo solicitante
          até o momento da execução do serviço. A ausência de informações relevantes, documentos incompletos ou dados
          imprecisos pode alterar substancialmente a conclusão apresentada.
        </p>

        <p>
          A análise inicial não representa promessa de resultado, garantia de êxito ou obrigação de adoção de medida específica.
        </p>

        <h2>9. Dados pessoais e confidencialidade</h2>

        <p>
          As informações encaminhadas serão utilizadas exclusivamente para organização, análise e tratamento da demanda apresentada,
          observados os princípios da finalidade, necessidade, adequação e segurança previstos na Lei nº 13.709/2018 — Lei Geral
          de Proteção de Dados.
        </p>

        <p>
          Dados sensíveis, documentos pessoais e informações sigilosas serão tratados apenas na medida necessária à execução
          da análise solicitada.
        </p>

        <h2>10. Comunicações eletrônicas</h2>

        <p>
          As comunicações relacionadas à presente solicitação poderão ocorrer por meios eletrônicos, inclusive e-mail, WhatsApp,
          área de confirmação, links automatizados e ferramentas digitais utilizadas na operacionalização da análise.
        </p>

        <h2>11. Aceite</h2>

        <p>
          Ao aceitar esta proposta, o solicitante declara que leu e compreendeu o escopo do serviço, seus limites, o valor indicado,
          a forma de pagamento, a regra de pré-reserva de horário e a inexistência de promessa de resultado.
        </p>

        <p>
          O aceite eletrônico será suficiente para registrar a concordância com os termos desta proposta.
        </p>

        <h2>12. Próximos passos</h2>

        <p>
          Após o aceite, o solicitante receberá as instruções para pagamento. Após a confirmação do pagamento, a solicitação seguirá
          para processamento interno, organização técnica preliminar e posterior confirmação operacional das próximas etapas.
        </p>
      </div>

      <section class="schedule-box no-print">
        <h2>Seleção de reunião</h2>

        <p>
          Escolha a modalidade pretendida. Em seguida, selecione uma das opções de horário apresentadas.
        </p>

        <div class="choice-grid">
          <label class="choice-card">
            <input type="radio" name="modalidade" value="virtual">
            <strong>Reunião virtual</strong>
            <small>Disponibilidade consultada a partir do segundo dia útil subsequente.</small>
          </label>

          <label class="choice-card">
            <input type="radio" name="modalidade" value="presencial">
            <strong>Reunião presencial</strong>
            <small>Disponibilidade consultada a partir do terceiro dia útil subsequente.</small>
          </label>
        </div>

        <h3>Horários sugeridos</h3>

        <div class="time-options">
          <label class="time-card">
            <input type="radio" name="horario" value="{{horario_manha}}">
            <strong id="horarioManha">{{horario_manha}}</strong>
            <span>Período da manhã, entre 08h30 e 11h00.</span>
          </label>

          <label class="time-card">
            <input type="radio" name="horario" value="{{horario_tarde}}">
            <strong id="horarioTarde">{{horario_tarde}}</strong>
            <span>Período da tarde, entre 14h30 e 17h30.</span>
          </label>
        </div>

        <div class="notice">
          O horário selecionado ficará temporariamente pré-reservado. A confirmação definitiva dependerá do aceite da proposta
          e da validação do pagamento, conforme as regras operacionais indicadas acima.
        </div>

        <div class="checks">
          <div class="check-line">
            <input type="checkbox" id="cienciaReserva">
            <label for="cienciaReserva">
              Declaro ciência de que o horário selecionado permanecerá apenas pré-reservado até a confirmação do pagamento,
              observadas as regras de validação operacional.
            </label>
          </div>

          <div class="check-line">
            <input type="checkbox" id="aceiteProposta">
            <label for="aceiteProposta">
              Li e concordo com os termos da presente proposta de análise estratégica inicial.
            </label>
          </div>
        </div>

        <div id="statusAceite" class="status"></div>

        <div class="actions">
          <button class="btn btn-primary" id="btnAceitar" type="button" disabled>
            Aceitar proposta e pré-reservar horário
          </button>

          <button class="btn btn-secondary" type="button" onclick="window.print()">
            Imprimir proposta
          </button>
        </div>

        <div class="payment-box" id="paymentBox">
          <h2>Instruções de pagamento</h2>

          <p>
            Esta etapa ainda está preparada para validação visual do MVP. No fluxo definitivo, este bloco será alimentado
            automaticamente pelo Worker após o aceite da proposta e a criação da pré-reserva.
          </p>

          <p><strong>Chave PIX:</strong></p>

          <div class="pix-key" id="pixKey">
            {{chave_pix}}
          </div>

          <p>
            Após o pagamento, a validação operacional seguirá o prazo informado na proposta.
          </p>
        </div>
      </section>
    </section>
  </main>

  <footer>
    <p>
      <a href="/privacidade.html">Política de Privacidade</a>
      &nbsp;
      <a href="/termos.html">Termos de Uso</a>
      &nbsp;
      <a href="mailto:contato@aquinojuridico.com.br">Contato institucional</a>
    </p>
    <p>© 2026 Análise Legal. Todos os direitos reservados.</p>
  </footer>

  <script>
    const dados = JSON.parse(sessionStorage.getItem("analiseLegalResumo") || "{}");

    function escapeHTML(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function aplicarTexto(id, valor, fallback) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = valor && String(valor).trim() ? String(valor) : fallback;
    }

    function formatarDataAtual() {
      return new Date().toLocaleString("pt-BR", {
        timeZone: "America/Sao_Paulo",
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    const protocolo = dados.protocolo || "{{protocolo}}";
    const nome = dados.nome || "{{nome}}";
    const origem = dados.origem || dados.tema || "{{origem_demanda}}";
    const dataProposta = formatarDataAtual();

    aplicarTexto("protocoloTopo", protocolo, "{{protocolo}}");
    aplicarTexto("nomeTopo", nome, "{{nome}}");
    aplicarTexto("dataProposta", dataProposta, "{{data_proposta}}");
    aplicarTexto("origemDemanda", origem, "{{origem_demanda}}");

    aplicarTexto("valorProposta", dados.valorProposta || "R$ {{valor}}", "R$ {{valor}}");
    aplicarTexto("prazoProposta", dados.prazoProposta || "{{prazo}}", "{{prazo}}");

    aplicarTexto("horarioManha", dados.horarioManha || "{{horario_manha}}", "{{horario_manha}}");
    aplicarTexto("horarioTarde", dados.horarioTarde || "{{horario_tarde}}", "{{horario_tarde}}");

    document.title = `Proposta-${protocolo}-Analise-Legal`;

    const btnAceitar = document.getElementById("btnAceitar");
    const statusAceite = document.getElementById("statusAceite");
    const paymentBox = document.getElementById("paymentBox");

    function modalidadeSelecionada() {
      const el = document.querySelector('input[name="modalidade"]:checked');
      return el ? el.value : "";
    }

    function horarioSelecionado() {
      const el = document.querySelector('input[name="horario"]:checked');
      return el ? el.value : "";
    }

    function atualizarBotao() {
      const podeAvancar =
        modalidadeSelecionada() &&
        horarioSelecionado() &&
        document.getElementById("cienciaReserva").checked &&
        document.getElementById("aceiteProposta").checked;

      btnAceitar.disabled = !podeAvancar;
    }

    document.querySelectorAll('input[name="modalidade"], input[name="horario"], #cienciaReserva, #aceiteProposta')
      .forEach(function (el) {
        el.addEventListener("change", atualizarBotao);
      });

    function mostrarStatus(classe, texto) {
      statusAceite.className = `status visible ${classe}`;
      statusAceite.textContent = texto;
    }

    btnAceitar.addEventListener("click", function () {
      const aceite = {
        protocolo,
        nome,
        origem,
        modalidade: modalidadeSelecionada(),
        horario: horarioSelecionado(),
        aceiteProposta: true,
        cienciaReserva: true,
        aceiteEm: new Date().toISOString(),
        timezone: "America/Sao_Paulo"
      };

      sessionStorage.setItem("analiseLegalAceiteProposta", JSON.stringify(aceite));

      mostrarStatus(
        "ok",
        "Proposta aceita para fins de simulação do MVP. No fluxo definitivo, o Worker registrará o aceite, criará a pré-reserva e liberará as instruções de pagamento."
      );

      paymentBox.classList.add("visible");

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "proposta_aceita_mvp",
        protocolo,
        modalidade: aceite.modalidade,
        horario: aceite.horario
      });
    });

    window.addEventListener("beforeprint", function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "print_intent",
        page_path: location.pathname,
        page_title: document.title,
        protocolo
      });
    });
  </script>
</body>
</html>
