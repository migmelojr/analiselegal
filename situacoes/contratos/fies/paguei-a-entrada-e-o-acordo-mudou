  const els = {
    intakeStage: document.getElementById("intakeStage"),
    summaryStage: document.getElementById("summaryStage"),
    bookingStage: document.getElementById("bookingStage"),
    closedStage: document.getElementById("closedStage"),
    toSummaryButton: document.getElementById("toSummaryButton"),
    intakeError: document.getElementById("intakeError"),
    summaryBox: document.getElementById("summaryBox"),
    editAnswersButton: document.getElementById("editAnswersButton"),
    openBookingButton: document.getElementById("openBookingButton"),
    closeFlowButton: document.getElementById("closeFlowButton"),
    reopenButton: document.getElementById("reopenButton"),
    dateArea: document.getElementById("dateArea"),
    dateList: document.getElementById("dateList"),
    slotArea: document.getElementById("slotArea"),
    slotsLoading: document.getElementById("slotsLoading"),
    slotList: document.getElementById("slotList"),
    slotMessage: document.getElementById("slotMessage"),
    priceArea: document.getElementById("priceArea"),
    priceLabel: document.getElementById("priceLabel"),
    personalArea: document.getElementById("personalArea"),
    professionalIdentity: document.getElementById("professionalIdentity"),
    professionalName: document.getElementById("professionalName"),
    professionalRegistration: document.getElementById("professionalRegistration"),
    bookingMode: document.getElementById("bookingMode"),
    bookingDate: document.getElementById("bookingDate"),
    bookingTime: document.getElementById("bookingTime"),
    bookingValueRow: document.getElementById("bookingValueRow"),
    bookingValue: document.getElementById("bookingValue"),
    nome: document.getElementById("nome"),
    cpf: document.getElementById("cpf"),
    email: document.getElementById("email"),
    telefone: document.getElementById("telefone"),
    submitError: document.getElementById("submitError"),
    submitBookingButton: document.getElementById("submitBookingButton"),
    backToSummaryButton: document.getElementById("backToSummaryButton")
  };

  function showStage(target) {
    for (const stage of [els.intakeStage, els.summaryStage, els.bookingStage, els.closedStage]) {
      stage.hidden = stage !== target;
    }
    target.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function intakeComplete() {
    return Boolean(
      state.instituicao &&
      state.formalizada &&
      state.entradaPaga &&
      state.mudancas.length &&
      state.podePagarOriginal &&
      state.justificativa
    );
  }

  function updateIntakeButton() {
    els.toSummaryButton.disabled = !intakeComplete();
    if (intakeComplete()) els.intakeError.hidden = true;
  }

  function handleOptionClick(button, group, multiple) {
    const value = button.dataset.value;

    if (multiple) {
      const exists = state[group].includes(value);
      state[group] = exists
        ? state[group].filter(item => item !== value)
        : [...state[group], value];
      button.classList.toggle("is-selected", !exists);
    } else {
      state[group] = value;
      button.parentElement.querySelectorAll(".option-btn").forEach(item => {
        item.classList.toggle("is-selected", item === button);
      });
    }

    updateIntakeButton();
  }

  function summaryRows() {
    return [
      ["Instituição", labels.instituicao[state.instituicao]],
      ["Renegociação formalizada", labels.formalizada[state.formalizada]],
      ["Entrada paga", labels.entradaPaga[state.entradaPaga]],
      ["O que mudou", state.mudancas.map(item => labels.mudancas[item]).join(", ")],
      ["Pagamento nas condições anteriores", labels.podePagarOriginal[state.podePagarOriginal]],
      ["Justificativa apresentada", labels.justificativa[state.justificativa]]
    ];
  }

  function renderSummary() {
    els.summaryBox.innerHTML = summaryRows().map(([label, value]) => `
      <div class="summary-row">
        <span>${escapeHtml(label)}</span>
        <strong>${escapeHtml(value || "—")}</strong>
      </div>
    `).join("");
  }

  function summaryText() {
    return summaryRows()
      .map(([label, value]) => `${label}: ${value || "não informado"}`)
      .join("\n");
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function todayISOInSaoPaulo() {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: TIMEZONE,
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).formatToParts(new Date());

    const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
    return `${map.year}-${map.month}-${map.day}`;
  }

  function parseISODate(iso) {
    const [y, m, d] = iso.split("-").map(Number);
    return new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
  }

  function isoFromDate(date) {
    return date.toISOString().slice(0, 10);
  }

  function addDays(iso, amount) {
    const date = parseISODate(iso);
    date.setUTCDate(date.getUTCDate() + amount);
    return isoFromDate(date);
  }

  function isBusinessDay(iso) {
    const day = parseISODate(iso).getUTCDay();
    return day !== 0 && day !== 6;
  }

  function addBusinessDays(iso, amount) {
    let current = iso;
    let added = 0;
    while (added < amount) {
      current = addDays(current, 1);
      if (isBusinessDay(current)) added += 1;
    }
    return current;
  }

  function formatDateBR(iso, withWeekday = false) {
    if (!iso) return "—";
    const date = parseISODate(iso);
    const options = withWeekday
      ? { weekday: "short", day: "2-digit", month: "2-digit", timeZone: "UTC" }
      : { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" };
    return new Intl.DateTimeFormat("pt-BR", options).format(date).replace(".", "");
  }

  function minimumDateFor(mode) {
    const fromApi = state.config?.service?.minimum_dates?.[mode];
    if (/^\d{4}-\d{2}-\d{2}$/.test(fromApi || "")) return fromApi;
    return addBusinessDays(todayISOInSaoPaulo(), mode === "presencial" ? 2 : 1);
  }

  function buildEligibleDates(mode, count = 18) {
    const dates = [];
    let current = minimumDateFor(mode);
    while (dates.length < count) {
      if (isBusinessDay(current)) dates.push(current);
      current = addDays(current, 1);
    }
    return dates;
  }

  function renderDates() {
    state.data = "";
    state.hora = "";
    els.dateArea.hidden = false;
    els.slotArea.hidden = true;
    hidePriceAndPersonal();
    els.bookingDate.textContent = "—";
    els.bookingTime.textContent = "—";

    els.dateList.innerHTML = "";
    for (const iso of buildEligibleDates(state.modalidade)) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "date-btn";
      button.dataset.date = iso;

      const date = parseISODate(iso);
      const weekday = new Intl.DateTimeFormat("pt-BR", { weekday: "short", timeZone: "UTC" })
        .format(date)
        .replace(".", "");
      const dayMonth = new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", timeZone: "UTC" })
        .format(date);

      button.innerHTML = `<small>${escapeHtml(weekday)}</small><strong>${escapeHtml(dayMonth)}</strong>`;
      button.addEventListener("click", () => selectDate(iso, button));
      els.dateList.appendChild(button);
    }
  }

  async function selectDate(iso, button) {
    state.data = iso;
    state.hora = "";

    els.dateList.querySelectorAll(".date-btn").forEach(item => {
      item.classList.toggle("is-selected", item === button);
    });

    els.bookingDate.textContent = formatDateBR(iso);
    els.bookingTime.textContent = "—";
    els.slotArea.hidden = false;
    hidePriceAndPersonal();
    await loadSlots();
  }

  function slotHour(slot) {
    if (typeof slot === "string") {
      const match = slot.match(/\b(\d{2}:\d{2})\b/);
      return match ? match[1] : slot.slice(0, 5);
    }

    const direct = slot?.time || slot?.hora || slot?.hour;
    if (direct) return String(direct).slice(0, 5);

    const raw = slot?.starts_at || slot?.startsAt || slot?.start;
    if (!raw) return "";

    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "";

    return new Intl.DateTimeFormat("pt-BR", {
      timeZone: TIMEZONE,
      hour: "2-digit",
      minute: "2-digit",
      hour12: false
    }).format(date);
  }

  async function loadSlots() {
    els.slotsLoading.hidden = false;
    els.slotMessage.hidden = true;
    els.slotList.innerHTML = "";

    try {
      const url = new URL(WORKER_BASE + "/api/availability");
      url.searchParams.set("landing_page", LANDING_PAGE);
      url.searchParams.set("date", state.data);
      url.searchParams.set("service_mode", state.modalidade);

      const response = await fetch(url.toString(), {
        headers: { "Accept": "application/json" }
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error("availability_failed");

      const rawSlots = Array.isArray(data.slots)
        ? data.slots
        : Array.isArray(data.horarios_disponiveis)
          ? data.horarios_disponiveis
          : [];

      const hours = [...new Set(rawSlots.map(slotHour).filter(Boolean))].sort();

      if (!hours.length) {
        els.slotMessage.textContent = "Não há horários disponíveis nessa data. Escolha outro dia.";
        els.slotMessage.hidden = false;
        return;
      }

      for (const hour of hours) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "slot-btn";
        button.textContent = hour;
        button.addEventListener("click", () => selectTime(hour, button));
        els.slotList.appendChild(button);
      }
    } catch {
      els.slotMessage.textContent = "Não foi possível consultar os horários neste momento. Tente novamente.";
      els.slotMessage.hidden = false;
    } finally {
      els.slotsLoading.hidden = true;
    }
  }

  function selectTime(hour, button) {
    state.hora = hour;
    els.slotList.querySelectorAll(".slot-btn").forEach(item => {
      item.classList.toggle("is-selected", item === button);
    });

    els.bookingTime.textContent = hour;
    revealPriceAndPersonal();
  }

  function configuredPriceLabel() {
    return state.config?.service?.price_formatted || "R$ 1.000,00";
  }

  function revealPriceAndPersonal() {
    const price = configuredPriceLabel();
    els.priceLabel.textContent = price;
    els.bookingValue.textContent = price;
    els.priceArea.hidden = false;
    els.personalArea.hidden = false;
    els.bookingValueRow.hidden = false;
  }

  function hidePriceAndPersonal() {
    els.priceArea.hidden = true;
    els.personalArea.hidden = true;
    els.bookingValueRow.hidden = true;
  }

  function setMode(mode, button) {
    state.modalidade = mode;
    document.querySelectorAll(".mode-btn").forEach(item => {
      item.classList.toggle("is-selected", item === button);
    });

    els.bookingMode.textContent = mode === "presencial" ? "Presencial em Brasília" : "Online";
    renderDates();
  }

  async function loadLandingConfig() {
    try {
      const response = await fetch(
        WORKER_BASE + "/api/landing-pages/" + encodeURIComponent(LANDING_PAGE),
        { headers: { "Accept": "application/json" } }
      );

      if (!response.ok) throw new Error("config_failed");
      const data = await response.json();
      state.config = data;

      if (data?.service?.price_formatted) {
        els.priceLabel.textContent = data.service.price_formatted;
        els.bookingValue.textContent = data.service.price_formatted;
      }

      const professional = data?.professional;
      if (professional) {
        const name = professional.display_name || professional.full_name || "";
        const registration = professional.registration || "";
        if (name) {
          els.professionalName.textContent = name;
          els.professionalRegistration.textContent = registration;
          els.professionalIdentity.hidden = false;
        }
      }

      const modes = data?.service?.service_modes || data?.professional?.service_modes;
      if (Array.isArray(modes) && modes.length) {
        document.querySelectorAll(".mode-btn").forEach(button => {
          const enabled = modes.includes(button.dataset.mode);
          button.hidden = !enabled;
        });
      }
    } catch {
      state.config = null;
    }
  }

  function digits(value) {
    return String(value || "").replace(/\D/g, "");
  }

  function validCPF(value) {
    const cpf = digits(value);
    if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;

    let sum = 0;
    for (let i = 0; i < 9; i++) sum += Number(cpf[i]) * (10 - i);
    let first = (sum * 10) % 11;
    if (first === 10) first = 0;
    if (first !== Number(cpf[9])) return false;

    sum = 0;
    for (let i = 0; i < 10; i++) sum += Number(cpf[i]) * (11 - i);
    let second = (sum * 10) % 11;
    if (second === 10) second = 0;
    return second === Number(cpf[10]);
  }

  function validEmail(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || "").trim());
  }

  function validPhone(value) {
    const phone = digits(value);
    return phone.length >= 10 && phone.length <= 13;
  }

  function formatCPFInput(event) {
    let value = digits(event.target.value).slice(0, 11);
    value = value.replace(/(\d{3})(\d)/, "$1.$2");
    value = value.replace(/(\d{3})(\d)/, "$1.$2");
    value = value.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
    event.target.value = value;
  }

  function formatPhoneInput(event) {
    let value = digits(event.target.value).slice(0, 11);
    if (value.length > 10) {
      value = value.replace(/^(\d{2})(\d{5})(\d{4})$/, "($1) $2-$3");
    } else if (value.length > 6) {
      value = value.replace(/^(\d{2})(\d{4})(\d{0,4})$/, "($1) $2-$3");
    } else if (value.length > 2) {
      value = value.replace(/^(\d{2})(\d+)/, "($1) $2");
    }
    event.target.value = value;
  }

  function validatePersonalData() {
    const name = els.nome.value.trim();
    const cpf = els.cpf.value.trim();
    const email = els.email.value.trim();
    const phone = els.telefone.value.trim();

    if (name.length < 3) return "Informe seu nome completo.";
    if (!validCPF(cpf)) return "Informe um CPF válido.";
    if (!validEmail(email)) return "Informe um e-mail válido.";
    if (!validPhone(phone)) return "Informe um telefone válido.";
    if (!state.modalidade || !state.data || !state.hora) return "Escolha modalidade, data e horário.";
    return "";
  }

  async function createLeadIfNeeded() {
    if (state.protocolo) return state.protocolo;

    const response = await fetch(WORKER_BASE + "/api/leads", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({
        landing_page: LANDING_PAGE,
        nome: els.nome.value.trim(),
        email: els.email.value.trim(),
        telefone: els.telefone.value.trim(),
        cpf: digits(els.cpf.value),
        resumo: summaryText(),
        intake: {
          produto: "analise_individual",
          situacao: "fies_entrada_paga_acordo_mudou",
          origem: window.location.pathname,
          documentos: [],
          detalhes: {
            instituicao: state.instituicao,
            formalizada: state.formalizada,
            entrada_paga: state.entradaPaga,
            mudancas: state.mudancas,
            pode_pagar_acordo_original: state.podePagarOriginal,
            justificativa_apresentada: state.justificativa
          }
        }
      })
    });

    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data?.protocolo) {
      throw new Error("Não foi possível registrar a solicitação neste momento.");
    }

    state.protocolo = data.protocolo;
    return state.protocolo;
  }

  async function preReserve() {
    const response = await fetch(WORKER_BASE + "/api/bookings/pre-reserve", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({
        protocolo: state.protocolo,
        service_mode: state.modalidade,
        date: state.data,
        time: state.hora
      })
    });

    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data?.retake_token) {
      if (response.status === 409) {
        throw new Error("Esse horário deixou de estar disponível. Escolha outro horário.");
      }
      throw new Error("Não foi possível reservar o horário neste momento.");
    }

    return data;
  }

  async function submitBooking() {
    if (state.submitting) return;

    const validationError = validatePersonalData();
    if (validationError) {
      els.submitError.textContent = validationError;
      els.submitError.hidden = false;
      return;
    }

    els.submitError.hidden = true;
    state.submitting = true;
    els.submitBookingButton.disabled = true;
    els.submitBookingButton.textContent = "PREPARANDO PAGAMENTO...";

    try {
      await createLeadIfNeeded();
      const reservation = await preReserve();

      const token = reservation.retake_token;
      const payload = {
        protocolo: state.protocolo,
        token,
        booking_id: reservation.booking_id || "",
        expires_at: reservation.expires_at || ""
      };

      try {
        sessionStorage.setItem("analiseLegalPagamento", JSON.stringify(payload));
      } catch {
        /* O redirecionamento continua pela URL. */
      }

      const paymentUrl = new URL("/pagamento.html", window.location.origin);
      paymentUrl.searchParams.set("protocolo", state.protocolo);
      paymentUrl.searchParams.set("token", token);
      window.location.assign(paymentUrl.toString());
    } catch (error) {
      const message = error?.message || "Não foi possível concluir o pedido.";
      els.submitError.textContent = message;
      els.submitError.hidden = false;

      if (message.includes("horário")) {
        state.hora = "";
        els.bookingTime.textContent = "—";
        hidePriceAndPersonal();
        await loadSlots();
      }
    } finally {
      state.submitting = false;
      els.submitBookingButton.disabled = false;
      els.submitBookingButton.textContent = "FINALIZAR PEDIDO E IR PARA O PIX";
    }
  }

  document.querySelectorAll("[data-group]").forEach(group => {
    const name = group.dataset.group;
    const multiple = group.dataset.multiple === "true";
    group.querySelectorAll(".option-btn").forEach(button => {
      button.addEventListener("click", () => handleOptionClick(button, name, multiple));
    });
  });

  els.toSummaryButton.addEventListener("click", () => {
    if (!intakeComplete()) {
      els.intakeError.hidden = false;
      return;
    }
    renderSummary();
    showStage(els.summaryStage);
  });

  els.editAnswersButton.addEventListener("click", () => showStage(els.intakeStage));
  els.openBookingButton.addEventListener("click", () => showStage(els.bookingStage));
  els.closeFlowButton.addEventListener("click", () => showStage(els.closedStage));
  els.reopenButton.addEventListener("click", () => showStage(els.summaryStage));
  els.backToSummaryButton.addEventListener("click", () => showStage(els.summaryStage));

  document.querySelectorAll(".mode-btn").forEach(button => {
    button.addEventListener("click", () => setMode(button.dataset.mode, button));
  });

  els.cpf.addEventListener("input", formatCPFInput);
  els.telefone.addEventListener("input", formatPhoneInput);
  els.submitBookingButton.addEventListener("click", submitBooking);

  loadLandingConfig();
  </script>
</body>
</html>
